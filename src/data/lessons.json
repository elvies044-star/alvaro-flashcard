{
  "lessons": [
    {
      "id": "spok",
      "icon": "grid",
      "color": "#2f6df0",
      "title": "Struktur Kalimat",
      "subtitle": "Urutan kata dalam bahasa Mandarin",
      "legend": [["S", "Subjek"], ["P", "Predikat"], ["O", "Objek"], ["W", "Waktu"], ["T", "Tempat"], ["C", "Cara"], ["N", "Negasi"], ["Q", "Tanya"]],
      "sections": [
        {
          "h": "Pola dasar",
          "formula": ["S", "P", "O"],
          "body": "Seperti bahasa Indonesia, urutannya Subjek → Predikat (kata kerja) → Objek. Yang penting: kata kerja TIDAK pernah berubah bentuk.",
          "examples": [
            {"parts": [["我", "S"], ["吃", "P"], ["苹果", "O"]], "id": "Saya makan apel."},
            {"parts": [["他", "S"], ["喝", "P"], ["水", "O"]], "id": "Dia minum air."},
            {"parts": [["我们", "S"], ["学", "P"], ["中文", "O"]], "id": "Kami belajar bahasa Mandarin."}
          ]
        },
        {
          "h": "Keterangan waktu",
          "body": "Keterangan WAKTU diletakkan di awal kalimat atau tepat setelah subjek — bukan di akhir seperti bahasa Inggris.",
          "examples": [
            {"parts": [["我", "S"], ["今天", "W"], ["去", "P"], ["学校", "O"]], "id": "Hari ini saya pergi ke sekolah."},
            {"parts": [["明天", "W"], ["我", "S"], ["休息", "P"]], "id": "Besok saya istirahat."}
          ]
        },
        {
          "h": "Keterangan tempat (在)",
          "body": "Tempat memakai 在 + tempat, dan diletakkan SEBELUM kata kerja, bukan sesudahnya.",
          "examples": [
            {"parts": [["我", "S"], ["在家", "T"], ["看", "P"], ["书", "O"]], "id": "Saya membaca buku di rumah."},
            {"parts": [["他", "S"], ["在学校", "T"], ["学习", "P"]], "id": "Dia belajar di sekolah."}
          ]
        },
        {
          "h": "Urutan lengkap",
          "formula": ["S", "W", "T", "C", "P", "O"],
          "body": "Kalau ada banyak keterangan, urutannya tetap seperti rumus di atas.",
          "examples": [
            {"parts": [["我", "S"], ["今天", "W"], ["在家", "T"], ["用电脑", "C"], ["工作", "P"]], "id": "Hari ini saya bekerja di rumah pakai komputer."},
            {"parts": [["她", "S"], ["每天", "W"], ["在公园", "T"], ["跑步", "P"]], "id": "Dia lari di taman setiap hari."}
          ]
        },
        {
          "h": "Kalimat tanya",
          "body": "Tambahkan 吗 di akhir untuk tanya ya/tidak. Untuk tanya detail, pakai kata tanya (什么 apa, 哪里 di mana) di posisi jawabannya — urutan tidak berubah.",
          "examples": [
            {"parts": [["你", "S"], ["是", "P"], ["学生", "O"], ["吗", "Q"]], "id": "Apakah kamu murid?"},
            {"parts": [["你", "S"], ["吃", "P"], ["什么", "Q"]], "id": "Kamu makan apa?"},
            {"parts": [["他", "S"], ["在", "P"], ["哪里", "Q"]], "id": "Dia di mana?"}
          ]
        },
        {
          "h": "Negasi: 不 dan 没",
          "body": "不 menyangkal kebiasaan / sekarang / nanti. 没 menyangkal yang SUDAH terjadi (belum). Keduanya sebelum kata kerja.",
          "examples": [
            {"parts": [["我", "S"], ["不", "N"], ["喝", "P"], ["咖啡", "O"]], "id": "Saya tidak minum kopi."},
            {"parts": [["我", "S"], ["没", "N"], ["吃", "P"], ["饭", "O"]], "id": "Saya belum makan."}
          ]
        }
      ]
    },
    {
