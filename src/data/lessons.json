            {"zh": "月", "m": "bulan"},
            {"zh": "木", "m": "pohon"},
            {"zh": "人", "m": "orang"},
            {"zh": "水", "m": "air"}
          ]
        },
        {
          "h": "指事 — Tanda abstrak",
          "body": "Zhǐshì. Menunjuk ide yang tidak bisa digambar, dengan tanda sederhana.",
          "picto": [
            {"zh": "一", "m": "satu"},
            {"zh": "上", "m": "atas · tanda di atas garis"},
